    },
    "tools": [
      {
        "name": "get_me",
        "title": "Get current user",
        "description": "Return the signed-in user's profile and roles in Quality HSS.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_programs",
        "title": "List academic programs",
        "description": "List the academic programs the signed-in user can access.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_surveys",
        "title": "List surveys",
        "description": "List surveys visible to the signed-in user, optionally filtered by status, academic year, semester, or program.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "draft",
                    "active",
                    "closed"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by survey status."
            },
            "academic_year": {
              "type": [
                "string",
                "null"
              ],
              "description": "Filter by academic year, e.g. 2025-2026."
            },
            "semester": {
              "type": [
                "string",
                "null"
              ],
              "description": "Filter by semester."
            },
            "program_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by program UUID."
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 200
                },
                {
                  "type": "null"
                }
              ],
              "description": "Max rows to return (default 50)."
            }
          },
          "required": [
            "status",
            "academic_year",
            "semester",
            "program_id",
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_complaints",
